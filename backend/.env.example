PROJECT_NAME=Silk Optima Recruitment Portal API
DATABASE_URL=postgresql+psycopg2://NEON_USER:NEON_PASSWORD@NEON_HOST/NEON_DATABASE?sslmode=require
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=https://your-frontend.vercel.app
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=SilkOptima <no-reply@example.com>